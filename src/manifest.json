{
  "name": "Conditioner",
  "description": "Helps good girls apply their conditioner",
  "manifest_version": 3,
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "permissions": ["scripting", "webNavigation", "storage"],
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["src/scripts/drive.ts"]
    },
    {
      "matches": ["https://form.jotform.com/*"],
      "js": ["src/scripts/jotform.ts"]
    }
  ]
}
